{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CHIP-8 emulator",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/chip_8_emulator",
      "args": ["${input:romPath}"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "Build CHIP-8 emulator"
    }
  ],
  "inputs": [
    {
      "id": "romPath",
      "type": "promptString",
      "description": "Path to a CHIP-8 ROM",
      "default": "pong.ch8"
    }
  ]
}
